<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">


    <persistence-unit name="warehousePU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.utc.warehouse.entity.User</class>
        <class>com.utc.warehouse.entity.Category</class>
        <class>com.utc.warehouse.entity.Product</class>
        <class>com.utc.warehouse.entity.Supplier</class>
        <class>com.utc.warehouse.entity.Customer</class>
        <class>com.utc.warehouse.entity.StockTransaction</class>
        <class>com.utc.warehouse.entity.StockTransactionDetail</class>
        <class>com.utc.warehouse.entity.StockMovement</class>
        <class>com.utc.warehouse.entity.Invoice</class>
        <class>com.utc.warehouse.entity.InvoiceItem</class>
        <class>com.utc.warehouse.entity.Payment</class>
        <class>com.utc.warehouse.entity.AuditLog</class>
        <class>com.utc.warehouse.entity.PurchaseOrder</class>
        <class>com.utc.warehouse.entity.PurchaseOrderItem</class>

        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/warehouse_db?useUnicode=true&amp;characterEncoding=utf8&amp;useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Asia/Ho_Chi_Minh&amp;createDatabaseIfNotExist=true"/>
            <property name="jakarta.persistence.jdbc.user"      value="root"/>
            <property name="jakarta.persistence.jdbc.password"  value="example_123"/>
            <property name="jakarta.persistence.jdbc.driver"    value="com.mysql.cj.jdbc.Driver"/>

            <property name="hibernate.dialect"                 value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.show_sql"                 value="false"/>
            <property name="hibernate.format_sql"               value="true"/>
            <property name="hibernate.hbm2ddl.auto"             value="update"/>
            <property name="hibernate.connection.characterEncoding" value="utf8"/>
        </properties>
    </persistence-unit>
</persistence>
